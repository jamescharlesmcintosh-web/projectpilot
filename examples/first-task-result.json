{
  "summary": "Add a small interactive sample page",
  "files": [
    {
      "path": "index.html",
      "content": "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>My first ProjectPilot build</title><style>body{background:#0d0f12;color:#e2e8f0;font:18px system-ui;margin:0;min-height:100vh;display:grid;place-items:center}main{max-width:36rem;padding:2rem}h1{font-size:clamp(2rem,7vw,3.5rem);line-height:1.05}button{background:#38bdf8;color:#07121a;border:0;padding:1rem;border-radius:.6rem;font:inherit;cursor:pointer}button:focus-visible{outline:3px solid white;outline-offset:4px}output{font-size:2rem;display:block;margin:1rem 0}p{color:#94a3b8;line-height:1.6}</style></head><body><main><p>MY FIRST LOCAL BUILD</p><h1>Small steps. Real progress.</h1><p>This sample is a real file. Click the button, check the result, then approve its local Git commit in ProjectPilot.</p><output id=\"count\" aria-live=\"polite\">0 steps</output><button id=\"step\">Take one step</button></main><script>let count=0;document.getElementById('step').addEventListener('click',()=>{count++;document.getElementById('count').textContent=count+' step'+(count===1?'':'s');});</script></body></html>\n"
    }
  ]
